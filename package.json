{
  "name": "@enirman/ui",
  "version": "4.1.1",
  "description": "Shared design system for eNirman apps — shadcn-vue primitives + app shell + design tokens",
  "main": "src/index.js",
  "module": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./theme.css": "./src/theme.css",
    "./tailwind-preset": "./tailwind-preset.js",
    "./lib/utils": "./src/lib/utils.js",
    "./assets": "./src/assets/index.js",
    "./assets/*": "./src/assets/*",
    "./EuiDwgViewer": "./src/components/app/EuiDwgViewer/index.js"
  },
  "files": [
    "src",
    "tailwind-preset.js",
    "docs",
    "!docs/*-demo.html",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check:tokens": "node scripts/check-theme-tokens.mjs",
    "check:parity": "node scripts/check-token-parity.mjs",
    "check:drift": "node scripts/check-publish-drift.mjs",
    "check": "npm run check:tokens && npm run check:parity && npm run check:drift",
    "prepublishOnly": "npm run check",
    "play": "vite"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.468.0",
    "reka-ui": "^2.0.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "vue-sonner": "^1.3.0"
  },
  "peerDependencies": {
    "@vueuse/core": "^10.0.0 || ^11.0.0 || ^12.0.0 || ^13.0.0 || ^14.0.0",
    "tailwindcss": "^3.4.0",
    "vue": "^3.4.0",
    "vue-router": "^4.0.0",
    "@mlightcad/cad-simple-viewer": "^1.4.12",
    "@mlightcad/cad-viewer": "^1.4.12",
    "element-plus": "^2.13.7"
  },
  "peerDependenciesMeta": {
    "@mlightcad/cad-simple-viewer": { "optional": true },
    "@mlightcad/cad-viewer": { "optional": true },
    "element-plus": { "optional": true }
  },
  "keywords": [
    "enirman",
    "design-system",
    "vue",
    "shadcn",
    "reka-ui"
  ],
  "private": false,
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "@vueuse/core": "^14.2.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.0",
    "vite": "^5.2.8",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  }
}
